{
  "name": "zerocad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A general nonlinear constraint solver (Rust/WASM kernel, AD-based Jacobians) with a runtime-extensible TypeScript tool/relation-authoring layer. 2D CAD sketch is the first standard library built on it.",
  "scripts": {
    "build:kernel": "cd kernel-rs && wasm-pack build --target web --out-dir ../src/kernel/wasm-gen",
    "test:kernel": "cd kernel-rs && cargo test",
    "dev": "vite",
    "build": "npm run build:kernel && vite build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "node --experimental-strip-types test/e2e/run.ts",
    "test:all": "npm run typecheck && npm test && npm run test:kernel && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "build:kernel:dev": "cd kernel-rs && wasm-pack build --dev --target web --out-dir ../src/kernel/wasm-gen",
    "build:single": "node scripts/singlefile.mjs",
    "build:pwa": "node --experimental-strip-types scripts/pwa.ts",
    "build:icons": "node --experimental-strip-types scripts/icons.ts",
    "build:screenshots": "node --experimental-strip-types test/e2e/run.ts scripts/screenshots.ts",
    "measure:depth": "node --experimental-strip-types test/e2e/run.ts test/e2e/depth.measure.ts",
    "measure:android": "node --experimental-strip-types test/e2e/run.ts test/e2e/android.measure.ts",
    "measure:hidden": "node --experimental-strip-types test/e2e/run.ts test/e2e/hidden.measure.ts",
    "build:solids": "bash scripts/solids/build.sh"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
